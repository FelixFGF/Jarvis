<Window x:Class="Jarvis.BetaActivationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Jarvis Beta Activation" Width="580" Height="680" MinWidth="500" MinHeight="520" WindowStartupLocation="CenterScreen" Background="#101115" Foreground="#F1F0F5" ResizeMode="CanResize" Loaded="Window_Loaded">
 <Grid Margin="26">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <StackPanel Orientation="Horizontal" Margin="0,0,0,20"><Border Width="46" Height="46" CornerRadius="15" Background="#282044"><Image Source="Assets/Jarvis.png" Margin="7"/></Border><StackPanel Margin="12,1,0,0"><TextBlock Text="JARVIS" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="CLOSE BETA ACCESS" Foreground="#A09EAB" FontSize="11"/></StackPanel></StackPanel>
   <TextBlock Text="Activate your beta account" FontSize="25" FontWeight="SemiBold" Margin="0,0,0,8"/>
   <TextBlock Text="Continue with your authenticated Discord account, then enter the single-use code assigned to you." Foreground="#A09EAB" TextWrapping="Wrap"/>
  </StackPanel>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,18,0,12">
   <Border Background="#191A20" BorderBrush="#363740" BorderThickness="1" CornerRadius="14" Padding="20">
    <StackPanel>
     <Button x:Name="DiscordButton" Content="Continue with Discord" Click="Discord_Click" Background="#6857C8" Height="46" FontSize="15"/>
     <Button x:Name="SwitchAccountButton" Content="Switch Account" Click="SwitchAccount_Click" Height="38" Margin="0,8,0,0"/>
     <Border x:Name="IdentityPanel" Visibility="Collapsed" Background="#202127" CornerRadius="10" Padding="12" Margin="0,14,0,14">
      <StackPanel Orientation="Horizontal"><Border Width="48" Height="48" CornerRadius="24" Background="#302A55" Margin="0,0,12,0"><Grid><Image x:Name="DiscordAvatar" Stretch="UniformToFill"/><TextBlock x:Name="AvatarFallback" Text="D" Foreground="#C2B7FF" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border><StackPanel VerticalAlignment="Center"><TextBlock x:Name="DiscordName" FontWeight="SemiBold"/><TextBlock x:Name="DiscordId" Foreground="#A09EAB" FontSize="11"/></StackPanel></StackPanel>
     </Border>
     <TextBlock Text="Beta activation code" Foreground="#B8B6C2" Margin="0,10,0,5"/><TextBox x:Name="InviteBox" Height="40" Padding="10" Background="#202127" Foreground="#F1F0F5" BorderBrush="#353640"/>
     <Button x:Name="ActivateButton" Content="Activate Jarvis" Click="Activate_Click" Background="#6857C8" Height="44" Margin="0,14,0,0" IsEnabled="False"/>
     <Button x:Name="SignOutButton" Content="Forget saved session" Click="SignOut_Click" Visibility="Collapsed" HorizontalAlignment="Left" Margin="-3,12,0,0"/>
    </StackPanel>
   </Border>
  </ScrollViewer>
  <StackPanel Grid.Row="2"><TextBlock x:Name="StatusText" Text="Checking beta service…" Foreground="#A09EAB" TextWrapping="Wrap" MinHeight="42"/><TextBlock Text="Jarvis never asks for your Discord password. Sign-in runs in Discord's official browser authorization page." Foreground="#777583" FontSize="11" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel>
 </Grid>
</Window>
