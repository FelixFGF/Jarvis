<Application x:Class="Jarvis.BetaManager.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Bg" Color="#101115"/><SolidColorBrush x:Key="Panel" Color="#191A20"/><SolidColorBrush x:Key="Field" Color="#202127"/><SolidColorBrush x:Key="Accent" Color="#A894FF"/><SolidColorBrush x:Key="Text" Color="#F1F0F5"/><SolidColorBrush x:Key="Muted" Color="#A09EAB"/>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="{StaticResource Field}"/><Setter Property="BorderBrush" Value="#393944"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,4,0,10"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="{StaticResource Field}"/><Setter Property="BorderBrush" Value="#393944"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,4,0,10"/></Style>
  <Style TargetType="Button"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="#252630"/><Setter Property="BorderBrush" Value="#41414F"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="13,8"/><Setter Property="Margin" Value="3"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="DatePicker"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="{StaticResource Field}"/><Setter Property="BorderBrush" Value="#393944"/><Setter Property="Padding" Value="7"/></Style>
  <Style TargetType="TabControl"><Setter Property="Background" Value="{StaticResource Bg}"/><Setter Property="Foreground" Value="{StaticResource Text}"/></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Padding" Value="14,9"/><Setter Property="Background" Value="#191A20"/></Style>
  <Style TargetType="DataGrid"><Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="RowBackground" Value="#191A20"/><Setter Property="AlternatingRowBackground" Value="#202127"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="HorizontalGridLinesBrush" Value="#343540"/><Setter Property="BorderBrush" Value="#363740"/><Setter Property="ColumnHeaderStyle"><Setter.Value><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#24242D"/><Setter Property="Foreground" Value="{StaticResource Accent}"/><Setter Property="Padding" Value="9,8"/><Setter Property="BorderBrush" Value="#363740"/></Style></Setter.Value></Setter></Style>
  <Style TargetType="DataGridCell"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="7,5"/><Setter Property="BorderThickness" Value="0"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#39334F"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style>
 </Application.Resources>
</Application>
