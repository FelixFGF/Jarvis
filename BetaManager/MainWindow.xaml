<Window x:Class="Jarvis.BetaManager.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Jarvis Beta Manager" Width="1120" Height="780" MinWidth="900" MinHeight="620" WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" Foreground="{StaticResource Text}" Loaded="Window_Loaded">
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,18"><StackPanel Orientation="Horizontal"><Border Width="42" Height="42" CornerRadius="13" Background="#282044"><Image Source="Assets/Jarvis.png" Margin="6"/></Border><StackPanel Margin="12,2,0,0"><TextBlock Text="JARVIS" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="BETA MANAGER" FontSize="10" Foreground="{StaticResource Muted}"/></StackPanel></StackPanel><TextBlock x:Name="ConnectionStatus" DockPanel.Dock="Right" Text="Not connected" Foreground="{StaticResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Right"/></DockPanel>
  <Grid Grid.Row="1">
   <Border x:Name="LoginPanel" Background="{StaticResource Panel}" BorderBrush="#363740" BorderThickness="1" CornerRadius="14" Padding="26" HorizontalAlignment="Center" VerticalAlignment="Center" Width="480">
    <StackPanel><TextBlock Text="Administrator sign-in" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,6"/><TextBlock Text="Authenticate with a Supabase account that was explicitly bootstrapped as an administrator." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,18"/>
     <TextBlock Text="Supabase project URL"/><TextBox x:Name="UrlBox"/><TextBlock Text="Publishable / anon key"/><TextBox x:Name="KeyBox"/><Button Content="Save backend settings" Click="SaveBackend_Click" HorizontalAlignment="Left"/>
     <Separator Margin="0,14" Background="#363740"/><TextBlock Text="Administrator email"/><TextBox x:Name="EmailBox"/><TextBlock Text="Password"/><PasswordBox x:Name="PasswordBox"/><Button x:Name="SignInButton" Content="Sign in" Click="SignIn_Click" Background="#6857C8" HorizontalAlignment="Stretch" Margin="0,6,0,0"/><TextBlock x:Name="LoginMessage" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,12,0,0"/>
    </StackPanel>
   </Border>
   <TabControl x:Name="ManagerTabs" Visibility="Collapsed">
    <TabItem Header="Dashboard"><ScrollViewer><StackPanel Margin="18"><TextBlock Text="Beta overview" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Live server data" Foreground="{StaticResource Muted}" Margin="0,4,0,18"/><UniformGrid Columns="3" Margin="0,0,0,16"><Border Background="{StaticResource Panel}" CornerRadius="12" Padding="18" Margin="4"><StackPanel><TextBlock Text="Active licenses" Foreground="{StaticResource Muted}"/><TextBlock x:Name="ActiveCount" Text="—" FontSize="30" FontWeight="SemiBold"/></StackPanel></Border><Border Background="{StaticResource Panel}" CornerRadius="12" Padding="18" Margin="4"><StackPanel><TextBlock Text="Pending invitations" Foreground="{StaticResource Muted}"/><TextBlock x:Name="PendingCount" Text="—" FontSize="30" FontWeight="SemiBold"/></StackPanel></Border><Border Background="{StaticResource Panel}" CornerRadius="12" Padding="18" Margin="4"><StackPanel><TextBlock Text="Expired / revoked" Foreground="{StaticResource Muted}"/><TextBlock x:Name="InactiveCount" Text="—" FontSize="30" FontWeight="SemiBold"/></StackPanel></Border></UniformGrid><TextBlock Text="Recent activity" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,8"/><DataGrid x:Name="DashboardAuditGrid" IsReadOnly="True" AutoGenerateColumns="False" Height="330"><DataGrid.Columns><DataGridTextColumn Header="When (UTC)" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="160"/><DataGridTextColumn Header="Administrator" Binding="{Binding AdminUserId}" Width="*"/><DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="170"/><DataGridTextColumn Header="Outcome" Binding="{Binding Outcome}" Width="100"/></DataGrid.Columns></DataGrid></StackPanel></ScrollViewer></TabItem>
    <TabItem Header="Generate invite"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18" MaxWidth="760" HorizontalAlignment="Left"><TextBlock Text="Create tester invitation" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Each single-use code is bound to the intended Discord ID and display name. No code is sent to Discord automatically." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,18"/><Border Background="{StaticResource Panel}" BorderBrush="#363740" BorderThickness="1" CornerRadius="12" Padding="18"><StackPanel><TextBlock Text="Discord User ID"/><TextBox x:Name="DiscordUserIdBox" MaxLength="20" ToolTip="17–20 digit Discord snowflake"/><TextBlock Text="Discord Display Name" Margin="0,10,0,0"/><TextBox x:Name="DiscordDisplayNameBox" MaxLength="100"/><TextBlock Text="Identity status: Admin-entered · unverified" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,12"/><TextBlock Text="Internal note / ticket reference (optional)"/><TextBox x:Name="InviteNoteBox" MaxLength="500"/><TextBlock Text="Invitation expiry" Margin="0,10,0,0"/><ComboBox x:Name="InviteExpiryCombo" SelectedIndex="0"><ComboBoxItem Content="No expiry" Tag="none"/><ComboBoxItem Content="24 hours" Tag="24h"/><ComboBoxItem Content="7 days" Tag="7d"/><ComboBoxItem Content="30 days" Tag="30d"/></ComboBox><Button x:Name="CreateInviteButton" Content="Generate single-use invitation" Click="CreateInvite_Click" Background="#6857C8" HorizontalAlignment="Left" Margin="0,16,0,0"/></StackPanel></Border><Border Background="{StaticResource Panel}" BorderBrush="#363740" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,14,0,0"><StackPanel><TextBlock Text="Invitation code" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="The raw code is shown only after the server confirms it has been stored. Copy and deliver it manually through the approved ticket." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,10"/><ListBox x:Name="GeneratedCodesList" Background="{StaticResource Field}" Foreground="{StaticResource Text}" MinHeight="50"/><Button x:Name="CopyCodeButton" Content="Copy code" Click="CopyCode_Click" HorizontalAlignment="Left"/></StackPanel></Border></StackPanel></ScrollViewer></TabItem>
    <TabItem Header="Invitations"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,12"><TextBlock Text="Tester invitations" FontSize="24" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><ComboBox x:Name="InviteStatusFilter" Width="130" SelectedIndex="0" Margin="4,0" SelectionChanged="InviteFilter_Changed"><ComboBoxItem Content="All statuses" Tag="all"/><ComboBoxItem Content="Pending" Tag="pending"/><ComboBoxItem Content="Redeemed" Tag="redeemed"/><ComboBoxItem Content="Revoked" Tag="revoked"/><ComboBoxItem Content="Expired" Tag="expired"/></ComboBox><TextBox x:Name="InviteSearchBox" Width="240" Margin="6,0"/><Button Content="Search / refresh" Click="RefreshInvites_Click"/></StackPanel></DockPanel><DataGrid x:Name="InvitesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="InviteSelection_Changed"><DataGrid.Columns><DataGridTextColumn Header="Discord display name" Binding="{Binding DiscordDisplayName}" Width="180"/><DataGridTextColumn Header="Discord User ID" Binding="{Binding DiscordUserId}" Width="180"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90"/><DataGridTextColumn Header="Created (UTC)" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="150"/><DataGridTextColumn Header="Expires (UTC)" Binding="{Binding ExpiresAt, StringFormat=yyyy-MM-dd HH:mm}" Width="150"/><DataGridTextColumn Header="License" Binding="{Binding LicenseStatus}" Width="90"/></DataGrid.Columns></DataGrid><Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="10" Padding="12" Margin="0,10,0,0"><TextBlock x:Name="InviteDetailsText" Text="Select an invitation to view its details." TextWrapping="Wrap" Foreground="{StaticResource Muted}"/></Border><StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"><Button x:Name="CopyInviteCodeButton" Content="Copy code" Click="CopyInviteCode_Click" IsEnabled="False"/><Button Content="View details" Click="ViewInviteDetails_Click"/><Button x:Name="RevokeInviteButton" Content="Revoke invitation" Click="RevokeInvite_Click" IsEnabled="False"/><Button x:Name="DeleteInviteButton" Content="Delete unused invitation" Click="DeleteInvite_Click" IsEnabled="False"/><Button x:Name="RevokeAssociatedLicenseButton" Content="Revoke associated license" Click="RevokeAssociatedLicense_Click" IsEnabled="False"/></StackPanel></Grid></TabItem>    <TabItem Header="Licenses"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,12"><TextBlock Text="Tester licenses" FontSize="24" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><ComboBox x:Name="LicenseStatusFilter" Width="130" SelectedIndex="0" Margin="4,0" SelectionChanged="LicenseFilter_Changed"><ComboBoxItem Content="All statuses" Tag="all"/><ComboBoxItem Content="Active" Tag="active"/><ComboBoxItem Content="Revoked" Tag="revoked"/><ComboBoxItem Content="Expired" Tag="expired"/></ComboBox><TextBox x:Name="LicenseSearchBox" Width="260" Margin="6,0"/><Button Content="Search / refresh" Click="RefreshLicenses_Click"/></StackPanel></DockPanel><DataGrid x:Name="LicensesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="LicenseSelection_Changed"><DataGrid.Columns><DataGridTextColumn Header="Discord display name" Binding="{Binding DiscordDisplayName}" Width="180"/><DataGridTextColumn Header="Discord User ID" Binding="{Binding DiscordUserId}" Width="180"/><DataGridTextColumn Header="Jarvis/Supabase account" Binding="{Binding Email}" Width="*"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="85"/><DataGridTextColumn Header="Redeemed (UTC)" Binding="{Binding InviteRedeemedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="145"/><DataGridTextColumn Header="Expires (UTC)" Binding="{Binding ExpiresAt, StringFormat=yyyy-MM-dd HH:mm}" Width="145"/></DataGrid.Columns></DataGrid><Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="10" Padding="12" Margin="0,10,0,0"><StackPanel Orientation="Horizontal"><Border Width="48" Height="48" CornerRadius="24" Background="#302A55" Margin="0,0,12,0"><Grid><Image x:Name="LicenseAvatar" Stretch="UniformToFill"/><TextBlock x:Name="LicenseAvatarFallback" Text="J" Foreground="#C2B7FF" FontWeight="SemiBold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border><TextBlock x:Name="LicenseDetailsText" Text="Select a member to view account, invitation, identity status, and internal note details." TextWrapping="Wrap" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></StackPanel></Border><StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"><Button Content="Revoke license" Click="Revoke_Click"/><Button Content="Reinstate license" Click="Reinstate_Click"/></StackPanel></Grid></TabItem>
    <TabItem Header="Audit log"><Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel Margin="0,0,0,12"><TextBlock Text="Administrative activity" FontSize="24" FontWeight="SemiBold"/><Button Content="Refresh" DockPanel.Dock="Right" Click="RefreshAudit_Click"/></DockPanel><DataGrid x:Name="AuditGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="When (UTC)" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="170"/><DataGridTextColumn Header="Administrator" Binding="{Binding AdminUserId}" Width="*"/><DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="180"/><DataGridTextColumn Header="Target" Binding="{Binding TargetId}" Width="230"/><DataGridTextColumn Header="Outcome" Binding="{Binding Outcome}" Width="100"/></DataGrid.Columns></DataGrid></Grid></TabItem>
    <TabItem Header="Settings"><StackPanel Margin="18" MaxWidth="640" HorizontalAlignment="Left"><TextBlock Text="Backend and session" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="The publishable key is public client configuration. Never enter a service-role or server secret here." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,14"/><TextBlock Text="Supabase project URL"/><TextBox x:Name="SettingsUrlBox"/><TextBlock Text="Publishable / anon key"/><TextBox x:Name="SettingsKeyBox"/><StackPanel Orientation="Horizontal"><Button Content="Save backend settings" Click="SettingsSaveBackend_Click"/><Button Content="Test connection" Click="TestConnection_Click"/><Button Content="Sign out" Click="SignOut_Click"/></StackPanel><TextBlock x:Name="SettingsMessage" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,14,0,0"/></StackPanel></TabItem>
   </TabControl>
  </Grid>
  <TextBlock x:Name="FooterStatus" Grid.Row="2" Text="Ready" Foreground="{StaticResource Muted}" Margin="0,14,0,0"/>
 </Grid>
</Window>
