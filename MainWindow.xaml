lick="Models_Click"/><Button Grid.Column="3" Content="＋ Anhängen" Padding="10,7" ToolTip="Dateien bis 10 MB anhängen" Click="AttachFiles_Click"/><TextBlock x:Name="ModelStatus" Grid.Column="4" Text="Enter sendet · Shift+Enter neue Zeile" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="5"/><Button x:Name="CancelButton" Grid.Column="6" Content="Stop" Visibility="Collapsed" Click="Cancel_Click"/><Button x:Name="MicButton" Grid.Column="7" Content="🎙" MinWidth="38" Padding="9,7" ToolTip="Spracheingabe starten" Click="Mic_Click"/><Button x:Name="SendButton" Grid.Column="8" Content="↑" FontSize="18" Padding="12,5" Background="#6655C8" Click="Send_Click"/></Grid></Grid></Border>
