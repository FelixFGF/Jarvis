    <ScrollViewer x:Name="AgentPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Agentenaktivitäten" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="OpenAI-Tool-Calling für Leseaufgaben. Änderungen sind auf freigegebene Arbeitsordner beschränkt und benötigen Bestätigung." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,18"/><Border Background="{StaticResource Panel}" CornerRadius="10" Padding="16"><TextBlock Text="Der Agent stoppt nach höchstens fünf Modellrunden oder acht Werkzeugen."/></Border></StackPanel></ScrollViewer>
    <ScrollViewer x:Name="ToolsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Windows-Werkzeuge" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Direkt ausgelöste Aktionen und bestätigte Agenten-Werkzeuge." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,7,0,16"/><Border Background="{StaticResource Panel}" CornerRadius="12" Padding="16" Margin="0,4"><StackPanel><TextBlock Text="Programm starten" FontSize="15" FontWeight="SemiBold"/><DockPanel Margin="0,8,0,0"><Button DockPanel.Dock="Right" Content="Starten" Click="Launch_Click"/><TextBox x:Name="ProgramPath"/></DockPanel></StackPanel></Border><Border Background="{StaticResource Panel}" CornerRadius="12" Padding="16" Margin="0,4"><StackPanel><TextBlock Text="Datei oder Ordner öffnen" FontSize="15" FontWeight="SemiBold"/><DockPanel Margin="0,8,0,0"><Button DockPanel.Dock="Right" Content="Datei wählen …" Click="PickFile_Click"/><TextBox x:Name="OpenPath"/><Button Content="Öffnen" Click="OpenPath_Click"/></DockPanel></StackPanel></Border><Border Background="{StaticResource Panel}" CornerRadius="12" Padding="16" Margin="0,4"><StackPanel><TextBlock Text="Webseite öffnen" FontSize="15" FontWeight="SemiBold"/><DockPanel Margin="0,8,0,0"><Button DockPanel.Dock="Right" Content="Öffnen" Click="OpenUrl_Click"/><TextBox x:Name="UrlBox" Text="https://"/></DockPanel></StackPanel></Border><Border Background="{StaticResource Panel}" CornerRadius="12" Padding="16" Margin="0,4"><StackPanel><TextBlock Text="Dateien suchen" FontSize="15" FontWeight="SemiBold"/><DockPanel><Button DockPanel.Dock="Right" Content="Ordner wählen &amp; suchen" Click="SearchFiles_Click"/><TextBox x:Name="SearchBox" Text="*.*"/></DockPanel><TextBlock x:Name="SearchResults" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border></StackPanel></ScrollViewer>
