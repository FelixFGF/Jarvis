   <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Einstellungen" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12"/><TabControl x:Name="SettingsTabs"><TabItem Header="Profil"><StackPanel Margin="12"><TextBlock Text="Dein Profil" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Name und rund zugeschnittenes Profilbild" Foreground="{StaticResource Muted}" Margin="0,4,0,12"/><TextBlock Text="Anzeigename"/><TextBox x:Name="DisplayNameBox" Text="Lokales Profil" Margin="0,4,0,12"/><DockPanel><Button DockPanel.Dock="Right" Content="Profilbild wählen …" Click="ProfileImage_Click"/><TextBox x:Name="ProfileImagePathBox" IsReadOnly="True"/><Button Content="Entfernen" Click="ProfileImageClear_Click"/></DockPanel><WrapPanel Margin="0,16,0,0"><Button Content="Profil speichern" Background="#51469B" Click="SaveProfile_Click"/></WrapPanel><TextBlock x:Name="SettingsStatus" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8"/></StackPanel></TabItem><TabItem Header="KI-Verbindung"><StackPanel Margin="12"><TextBlock Text="Lokaler oder OpenAI-kompatibler Dienst" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Gespräch, bestätigte Memories, Anhänge und gelesene Dateiinhalte werden an diesen Endpunkt gesendet. Keine Hintergrundübertragung." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,14"/><TextBlock Text="API-Basis-URL"/><TextBox x:Name="EndpointBox" Text="http://localhost:1234/v1" Margin="0,4,0,12"/><TextBlock Text="Bevorzugtes Modell"/><DockPanel Margin="0,4,0,12"><Button DockPanel.Dock="Right" Content="Modelle laden" Click="Models_Click"/><TextBox x:Name="ModelBox"/></DockPanel><PasswordBox x:Name="ApiKeyBox" ToolTip="Optionaler API-Schlüssel für authentifizierte oder Cloud-kompatible Endpunkte; verschlüsselt für dieses Windows-Konto" Margin="0,0,0,8"/><TextBlock Text="Leer lassen, um den gespeicherten Schlüssel zu behalten. Chat-Inhalte werden an den konfigurierten Endpunkt gesendet." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap"/><TextBlock x:Name="ModelsResult" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/><WrapPanel Margin="0,10"><Button x:Name="TestConnectionButton" Content="Verbindung testen" Click="TestConnection_Click"/><Button Content="Einstellungen speichern" Background="#51469B" Click="SaveSettings_Click"/></WrapPanel><TextBlock Text="Systemprompt" FontSize="18" FontWeight="SemiBold" Margin="0,20,0,4"/><TextBlock Text="Diese Systemnachricht wird bei Chat-Anfragen verwendet." Foreground="{StaticResource Muted}" Margin="0,4"/><TextBox x:Name="SystemPromptBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="160" MaxHeight="300" VerticalScrollBarVisibility="Auto" Margin="0,6"/><Button Content="Standardprompt laden" HorizontalAlignment="Left" Click="ResetPrompt_Click"/></StackPanel></TabItem><TabItem Header="Datenschutz &amp; Werkzeuge"><StackPanel Margin="12"><TextBlock Text="Datenschutz" FontSize="18" FontWeight="SemiBold"/><CheckBox x:Name="SaveChatCheck" Content="Chatverlauf lokal speichern" IsChecked="True" Margin="0,8,0,16"/><TextBlock Text="Dateizugriff und Freigaben" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Dateizugriff ist auf diese freigegebenen Ordner begrenzt. Schreibvorgänge benötigen deine Bestätigung." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,8"/><DockPanel><Button DockPanel.Dock="Right" Content="Ordner freigeben …" Click="AddRoot_Click"/><TextBlock Text="Freigegebene Ordner" VerticalAlignment="Center"/></DockPanel><ListBox x:Name="ToolRootsList" Background="{StaticResource Panel}" Foreground="{StaticResource Text}" MinHeight="80" MaxHeight="150"/><TextBlock Text="Freigaben dauerhaft vertrauen" FontSize="16" FontWeight="SemiBold" Margin="0,20,0,5"/><TextBlock Text="Dauerhaftes Vertrauen gilt nur für genau dieselbe Aktion mit denselben Details. Du kannst Einträge hier suchen und widerrufen." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/><TextBox x:Name="TrustSearchBox" ToolTip="Freigaben durchsuchen" TextChanged="TrustSearch_TextChanged" Margin="0,0,0,6"/><ListBox x:Name="TrustedApprovalsList" DisplayMemberPath="Label" Background="{StaticResource Panel}" Foreground="{StaticResource Text}" MinHeight="60" MaxHeight="150"/><Button Content="Dauerhafte Freigabe widerrufen" Click="TrustRevoke_Click" HorizontalAlignment="Left" Margin="0,6"/><Button Content="Ausgewählten Ordner entfernen" Click="RemoveRoot_Click" HorizontalAlignment="Left" Margin="0,6"/><Button Content="Datenschutz- und Werkzeugeinstellungen speichern" Click="SaveSettings_Click" HorizontalAlignment="Left" Margin="0,12"/></StackPanel></TabItem><TabItem Header="Spracheingabe"><StackPanel Margin="12"><TextBlock Text="Lokale Spracheingabe" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Aufnahmen werden lokal mit Whisper verarbeitet. Der erkannte Text landet nur im Promptfeld und wird niemals automatisch gesendet." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,14"/><CheckBox x:Name="SpeechEnabledCheck" Content="Spracheingabe aktivieren" Margin="0,4,0,12" Checked="SpeechEnabled_Changed" Unchecked="SpeechEnabled_Changed"/><CheckBox x:Name="WakeWordEnabledCheck" Content="Freihändig aktivieren · Mikrofon im Hintergrund abhören" Margin="0,4,0,6" Checked="WakeWordSetting_Changed" Unchecked="WakeWordSetting_Changed"/><DockPanel Margin="0,0,0,10"><TextBlock Text="Aktivierungsphrase" VerticalAlignment="Center"/><TextBox x:Name="WakeWordPhraseBox" Text="Hey Jarvis" Width="220" DockPanel.Dock="Right"/></DockPanel><TextBlock Text="Die lokale Erkennung arbeitet offline. Die Standardphrase Hey Jarvis wird empfohlen; eigene kurze englische Phrasen können je nach Aussprache variieren." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"/><DockPanel Margin="0,2,0,10"><TextBlock Text="Erkennungston-Lautstärke" VerticalAlignment="Center"/><TextBlock x:Name="WakeSoundVolumeValue" Text="80 %" Foreground="{StaticResource Muted}" DockPanel.Dock="Right" VerticalAlignment="Center"/><Slider x:Name="WakeSoundVolumeSlider" Minimum="0" Maximum="100" Value="80" TickFrequency="5" ValueChanged="WakeSoundVolume_Changed" Margin="0,0,12,0"/></DockPanel><Button Content="Erkennungston testen" Click="WakeSoundTest_Click" HorizontalAlignment="Left" Margin="0,0,0,10"/><Button x:Name="WakeWordModelDownloadButton" Content="Aktivierungsmodell herunterladen" Click="WakeWordModelDownload_Click" HorizontalAlignment="Left" Margin="0,0,0,6"/><ProgressBar x:Name="WakeWordModelProgress" Height="5" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,6"/><TextBlock x:Name="WakeWordModelStatus" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"/><DockPanel Margin="0,2,0,10"><TextBlock Text="Pause bis zum Satzende" VerticalAlignment="Center"/><TextBlock x:Name="VoiceEndSilenceValue" Text="600 ms" Foreground="{StaticResource Muted}" DockPanel.Dock="Right" VerticalAlignment="Center"/><Slider x:Name="VoiceEndSilenceSlider" Minimum="350" Maximum="1500" Value="600" TickFrequency="50" ValueChanged="VoiceEndSilence_Changed" Margin="0,0,12,0"/></DockPanel><CheckBox x:Name="SpeechUseDefaultCheck" Content="Windows-Standardgerät verwenden" IsChecked="True" Margin="0,4,0,8" Checked="SpeechDefault_Changed" Unchecked="SpeechDefault_Changed"/><TextBlock Text="Mikrofon"/><DockPanel Margin="0,4,0,12"><Button DockPanel.Dock="Right" Content="Aktualisieren" Click="SpeechDevices_RefreshClick"/><ComboBox x:Name="SpeechDeviceBox" DisplayMemberPath="Name" SelectedValuePath="Id" Background="#202127" Foreground="{StaticResource Text}" BorderBrush="#393A43" Padding="8"/></DockPanel><TextBlock x:Name="SpeechDeviceStatus" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/><TextBlock Text="Whisper-Modell"/><ComboBox x:Name="SpeechModelBox" Margin="0,4,0,8" MaxDropDownHeight="360" SelectedValuePath="Tag" SelectionChanged="SpeechModel_Changed"><ComboBoxItem Content="Tiny · am schnellsten, geringere Genauigkeit (mehrsprachig)" Tag="tiny"/><ComboBoxItem Content="Base · schnell und ausgewogen (mehrsprachig)" Tag="base"/><ComboBoxItem Content="Small · genauer, benötigt mehr Zeit und Speicher" Tag="small"/><ComboBoxItem Content="Medium · hohe Genauigkeit, langsam und speicherintensiv" Tag="medium"/><ComboBoxItem Content="Large V3 Turbo · höchste Genauigkeit, großer Download und hoher RAM-Bedarf" Tag="large-v3-turbo"/></ComboBox><TextBlock x:Name="SpeechModelStatus" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,8"/><ProgressBar x:Name="SpeechDownloadProgress" Height="5" IsIndeterminate="True" Visibility="Collapsed"/><WrapPanel Margin="0,8,0,4"><Button x:Name="SpeechDownloadButton" Content="Modell herunterladen" Click="SpeechDownload_Click"/><Button Content="Spracheinstellungen speichern" Background="#51469B" Click="SpeechSave_Click"/></WrapPanel><TextBlock Text="Der erste Modell-Download benötigt Internet. Danach läuft die Erkennung offline; Modelle verwenden Q5_1-Quantisierung." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></TabItem><TabItem Header="Sprachausgabe"><StackPanel Margin="12"><TextBlock Text="Natürliche Sprachausgabe" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Piper erzeugt Sprache lokal auf deinem PC. Das ausgewählte Sprachmodell wird einmalig heruntergeladen und bleibt danach offline nutzbar." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,14"/><TextBlock Text="Sprachausgabe-Engine"/><ComboBox x:Name="TtsEngineBox" SelectedValuePath="Tag" SelectionChanged="TtsEngine_Changed" Margin="0,4,0,10"><ComboBoxItem Content="Windows-Stimmen" Tag="windows"/><ComboBoxItem Content="Neural · Piper Deutsch" Tag="piper"/></ComboBox><TextBlock Text="Neural-Stimme"/><ComboBox x:Name="TtsPiperVoiceBox" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="TtsPiperVoice_Changed" Background="#202127" Foreground="{StaticResource Text}" BorderBrush="#393A43" Padding="8" Margin="0,4,0,8"/><TextBlock x:Name="TtsModelStatus" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,8"/><ProgressBar x:Name="TtsDownloadProgress" Height="6" Visibility="Collapsed"/><WrapPanel Margin="0,4,0,14"><Button x:Name="TtsDownloadButton" Content="Neural-Stimme herunterladen" Click="TtsDownload_Click"/><Button Content="Stimme testen" Click="TtsPreview_Click"/></WrapPanel><TextBlock Text="Windows-Stimme"/><ComboBox x:Name="TtsVoiceBox" DisplayMemberPath="Name" SelectedValuePath="Name" Background="#202127" Foreground="{StaticResource Text}" BorderBrush="#393A43" Padding="8" Margin="0,4,0,8"/><TextBlock x:Name="TtsVoiceStatus" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"/><DockPanel Margin="0,4,0,10"><TextBlock Text="Ausgabelautstärke" VerticalAlignment="Center"/><TextBlock x:Name="TtsVolumeValue" Text="100 %" Foreground="{StaticResource Muted}" DockPanel.Dock="Right" VerticalAlignment="Center"/><Slider x:Name="TtsVolumeSlider" Minimum="0" Maximum="100" Value="100" TickFrequency="5" IsSnapToTickEnabled="False" ValueChanged="TtsVolume_Changed" Margin="0,0,12,0"/></DockPanel><Button Content="Sprachausgabe-Einstellungen speichern" Background="#51469B" HorizontalAlignment="Left" Click="SpeechSave_Click"/><TextBlock Text="Modell- und Zwischendateien werden im Jarvis-Ressourcenordner des bei der Installation gewählten Ordners gespeichert." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></TabItem><TabItem Header="Musik"><StackPanel Margin="12"><TextBlock Text="Musikdienste" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Spotify wird über OAuth PKCE verbunden. Dein Client-ID ist öffentlich, das Anmelde-Token wird verschlüsselt für dein Windows-Konto gespeichert. In Spotify Developer Dashboard muss die Redirect URI exakt eingetragen sein." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,12"/><TextBlock Text="Spotify Client ID"/><TextBox x:Name="SpotifyClientIdBox" Margin="0,4,0,8"/><TextBlock Text="Redirect URI: http://127.0.0.1:43821/callback/" Foreground="{StaticResource Muted}"/><WrapPanel Margin="0,8,0,16"><Button Content="Spotify verbinden" Click="SpotifyConnect_Click"/><Button Content="Spotify trennen" Click="SpotifyDisconnect_Click"/></WrapPanel><TextBlock x:Name="SpotifyConnectionStatus" Text="Spotify ist nicht verbunden." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,20"/><TextBlock Text="Apple Music" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Apple Music REST-Zugriff erfordert einen Apple Developer Token und einen Music User Token. Tokens werden DPAPI-verschlüsselt lokal gespeichert. Songwiedergabe wird über den Windows-Standardhandler geöffnet; die REST-API kann die Wiedergabe nicht verlässlich bestätigen." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,12"/><TextBlock Text="Apple Music Developer Token"/><PasswordBox x:Name="AppleMusicDeveloperTokenBox" Margin="0,4,0,8"/><TextBlock Text="Apple Music User Token"/><PasswordBox x:Name="AppleMusicUserTokenBox" Margin="0,4,0,8"/><DockPanel Margin="0,6"><TextBlock Text="Storefront" VerticalAlignment="Center"/><TextBox x:Name="AppleMusicStorefrontBox" Text="de" Width="100" DockPanel.Dock="Right"/></DockPanel><Button Content="Musikverbindungen speichern" Click="SaveMusicSettings_Click" HorizontalAlignment="Left" Margin="0,8"/><TextBlock x:Name="AppleMusicConnectionStatus" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel></TabItem><TabItem Header="Über"><StackPanel Margin="12"><TextBlock Text="Jarvis" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="AppVersionText" Text="Lokale Desktop-KI · Version" Foreground="{StaticResource Muted}" Margin="0,5"/><TextBlock Text="Entwickelt von Felix FGF" Foreground="{StaticResource Muted}" Margin="0,4"/><TextBlock Text="App-Sprache" FontWeight="SemiBold" Margin="0,22,0,5"/><ComboBox x:Name="AppLanguageBox" SelectedValuePath="Tag" SelectionChanged="AppLanguage_SelectionChanged" Width="220" HorizontalAlignment="Left"><ComboBoxItem Content="English" Tag="en"/><ComboBoxItem Content="Deutsch" Tag="de"/></ComboBox><TextBlock Text="Die Sprache kann jederzeit geändert werden. Jarvis antwortet standardmäßig in der ausgewählten Sprache." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,16"/><TextBlock x:Name="UpdateChannelLabel" Text="Release channel" FontWeight="SemiBold" Margin="0,8,0,5"/><ComboBox x:Name="UpdateChannelBox" SelectedValuePath="Tag" SelectionChanged="UpdateChannel_SelectionChanged" Width="220" HorizontalAlignment="Left"><ComboBoxItem Content="Stable" Tag="stable"/><ComboBoxItem Content="Beta / prerelease" Tag="beta"/></ComboBox><Button x:Name="UpdateCheckButton" Content="Check for updates" Click="CheckForUpdates_Click" HorizontalAlignment="Left" Margin="0,12,0,6"/><TextBlock x:Name="UpdateStatusText" Text="Updates are checked automatically at startup." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/></StackPanel></TabItem></TabControl></StackPanel></ScrollViewer>
