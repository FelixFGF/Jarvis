    <ScrollViewer x:Name="MemoryPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Was Jarvis über mich weiß" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Von dir eingetragene Informationen. Bestätigte Einträge können in den Modellkontext übernommen werden." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,14"/><TextBlock x:Name="MemorySummary" Text="Noch keine gespeicherten Informationen." TextWrapping="Wrap" Margin="0,0,0,14"/><Border Background="{StaticResource Panel}" CornerRadius="12" Padding="14" Margin="0,0,0,12"><StackPanel><TextBlock Text="Eintrag hinzufügen oder bearbeiten" FontWeight="SemiBold"/><TextBox x:Name="MemoryTextBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" Margin="0,8"/><DockPanel><TextBox x:Name="MemoryCategoryBox" Width="180" Text="Präferenz"/><CheckBox x:Name="MemoryConfirmedCheck" Content="Bestätigt" IsChecked="True" VerticalAlignment="Center" Margin="12,0"/><Button DockPanel.Dock="Right" Content="Speichern" Click="MemorySave_Click"/><Button DockPanel.Dock="Right" Content="Löschen" Click="MemoryDelete_Click"/></DockPanel></StackPanel></Border><TextBox x:Name="MemoryFilterBox" ToolTip="Erinnerungen durchsuchen" Margin="0,0,0,8" TextChanged="MemoryFilter_TextChanged"/><ListBox x:Name="MemoryList" Background="{StaticResource Panel}" BorderThickness="0" SelectionChanged="MemorySelection_Changed"><ListBox.ItemTemplate><DataTemplate><Border Padding="12" BorderBrush="#30313D" BorderThickness="0,0,0,1"><StackPanel><DockPanel><TextBlock Text="{Binding Category}" Foreground="{StaticResource Accent}" FontSize="11"/><TextBlock DockPanel.Dock="Right" Text="{Binding Confidence}" Foreground="{StaticResource Muted}" FontSize="10"/></DockPanel><TextBlock Text="{Binding Content}" TextWrapping="Wrap" Margin="0,5"/><TextBlock Text="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Foreground="{StaticResource Muted}" FontSize="10"/></StackPanel></Border></DataTemplate