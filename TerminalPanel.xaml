<UserControl x:Class="Jarvis.TerminalPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#090A0D" Foreground="#F2F1F6" PreviewKeyDown="TerminalPanel_PreviewKeyDown">
  <UserControl.Resources>
    <Style x:Key="TerminalButton" TargetType="Button"><Setter Property="Background" Value="#1A1B20"/><Setter Property="Foreground" Value="#E9E8EE"/><Setter Property="BorderBrush" Value="#343640"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="3,0"/><Setter Property="Cursor" Value="Hand"/></Style>
    <Style x:Key="TerminalTabItem" TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,4,0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#1B1C20" BorderBrush="#303138" BorderThickness="0,0,0,1" Padding="7,5">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <ListBox x:Name="SessionTabs" Grid.Column="0" MinHeight="34" Background="Transparent" BorderThickness="0" SelectedValuePath="Id" SelectionChanged="SessionTabs_SelectionChanged" ItemContainerStyle="{StaticResource TerminalTabItem}" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBox.ItemTemplate><DataTemplate><Border x:Name="TabBorder" Background="#25262B" BorderBrush="#404149" BorderThickness="1" CornerRadius="6" Padding="10,6" MinWidth="135" MaxWidth="250"><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/><TextBlock Text="  "/><TextBlock Text="{Binding WorkingDirectory}" Foreground="#AAA8B3" TextTrimming="CharacterEllipsis" MaxWidth="135"/></StackPanel></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#3D3563"/><Setter TargetName="TabBorder" Property="BorderBrush" Value="#786BC0"/></DataTrigger></DataTemplate.Triggers></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        <Button x:Name="NewPowerShellButton" Grid.Column="1" Content="＋" Style="{StaticResource TerminalButton}" FontSize="16" ToolTip="New terminal tab" Click="NewPowerShell_Click"/>
        <Button x:Name="NewTerminalMenuButton" Grid.Column="2" Content="⌄" Style="{StaticResource TerminalButton}" Padding="8,6" ToolTip="Choose terminal profile" Click="NewTerminalMenu_Click"/>
        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0"><Button x:Name="ClearButton" Content="Clear" Style="{StaticResource TerminalButton}" Click="Clear_Click"/><Button x:Name="CloseButton" Content="×" Style="{StaticResource TerminalButton}" ToolTip="Close active tab" Click="Close_Click"/></StackPanel>
        <Popup x:Name="NewTerminalPopup" Grid.ColumnSpan="3" Placement="Bottom" PlacementTarget="{Binding ElementName=NewPowerShellButton}" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"><Border Background="#202126" BorderBrush="#5D5778" BorderThickness="1" CornerRadius="8" Padding="7" Margin="0,5,0,0"><StackPanel Width="230"><TextBlock x:Name="NewTabHeading" Text="New terminal tab" Foreground="#B8B4C7" Margin="7,4,7,8"/><Button x:Name="PopupPowerShellButton" Content="▣  PowerShell" HorizontalContentAlignment="Left" Style="{StaticResource TerminalButton}" Margin="0,2" Click="PopupPowerShell_Click"/><Button x:Name="PopupCmdButton" Content="⌨  Command Prompt (CMD)" HorizontalContentAlignment="Left" Style="{StaticResource TerminalButton}" Margin="0,2" Click="PopupCmd_Click"/></StackPanel></Border></Popup>
      </Grid>
    </Border>
    <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBox x:Name="OutputBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Cascadia Mono, Consolas" FontSize="14" Background="#090A0D" Foreground="#E2E1E6" BorderThickness="0" Padding="12,10" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/><Border x:Name="ErrorContainer" Grid.Row="1" Background="#211317" BorderBrush="#60333B" BorderThickness="1,1,1,0" Padding="9" Visibility="Collapsed"><TextBox x:Name="ErrorBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="13" Background="Transparent" Foreground="#FF9CA5" BorderThickness="0" MaxHeight="140" VerticalScrollBarVisibility="Auto"/></Border></Grid>
    <Border Grid.Row="2" Background="#0D0E11" BorderBrush="#4B465D" BorderThickness="1,1,1,0" Padding="10,8"><DockPanel><Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Stop" Style="{StaticResource TerminalButton}" Visibility="Collapsed" Click="Cancel_Click"/><TextBlock x:Name="PromptLabel" FontFamily="Cascadia Mono, Consolas" FontSize="14" Foreground="#B5A7FF" VerticalAlignment="Center" Margin="2,0,8,0" Text="PS&gt;"/><TextBox x:Name="CommandBox" AcceptsReturn="False" IsReadOnly="False" IsTabStop="True" FontFamily="Cascadia Mono, Consolas" FontSize="14" MinHeight="26" Background="Transparent" BorderThickness="0" Foreground="#F4F3F7" CaretBrush="#F4F3F7" VerticalContentAlignment="Center" PreviewKeyDown="CommandBox_PreviewKeyDown"/></DockPanel></Border>
    <DockPanel Grid.Row="3" Background="#15161A" LastChildFill="True"><TextBlock x:Name="WorkingDirectoryLabel" DockPanel.Dock="Right" MaxWidth="560" Margin="10,5" Foreground="#85838E" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="TerminalState" Margin="10,5" Foreground="#AAA8B3" Text="No active terminal session."/></DockPanel>
  </Grid>
</UserControl>
