<UserControl x:Class="Jarvis.TerminalPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Background="#0C0D12" Foreground="#F2F1F6" PreviewKeyDown="TerminalPanel_PreviewKeyDown">
 <Grid Margin="8">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,7">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
    <Button x:Name="ClearButton" Content="Clear" ToolTip="Clear visible output" Click="Clear_Click"/>
    <Button x:Name="CloseButton" Content="Close" Click="Close_Click"/>
   </StackPanel>
   <ComboBox x:Name="SessionBox" MinWidth="210" MaxWidth="390" SelectedValuePath="Id" SelectionChanged="SessionBox_SelectionChanged">
    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding WorkingDirectory}" TextTrimming="CharacterEllipsis" ToolTip="{Binding WorkingDirectory}"/></DataTemplate></ComboBox.ItemTemplate>
   </ComboBox>
   <ComboBox x:Name="ShellBox" Width="112" Margin="7,0,0,0" SelectedValuePath="Tag" SelectedIndex="0"><ComboBoxItem Content="PowerShell" Tag="powershell"/><ComboBoxItem Content="CMD" Tag="cmd"/></ComboBox>
   <Button x:Name="NewSessionButton" Content="New" ToolTip="Start a new terminal session" Background="#4A3E86" Click="NewSession_Click"/>
  </DockPanel>
  <Grid Grid.Row="1">
   <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBox x:Name="OutputBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Cascadia Mono, Consolas" FontSize="13" Background="#0C0D12" Foreground="#D8D7DE" BorderBrush="#292B34" BorderThickness="1" Padding="9" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
   <Border x:Name="ErrorContainer" Grid.Row="1" Background="#211317" BorderBrush="#60333B" BorderThickness="1" Padding="7" Visibility="Collapsed">
    <TextBox x:Name="ErrorBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="12" Background="Transparent" Foreground="#FF9CA5" BorderThickness="0" MaxHeight="130" VerticalScrollBarVisibility="Auto"/>
   </Border>
  </Grid>
  <Border Grid.Row="2" Background="#15161C" BorderBrush="#343640" BorderThickness="1" CornerRadius="6" Margin="0,7,0,5" Padding="7,4">
   <DockPanel>
    <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Stop" ToolTip="Interrupt command (Ctrl+C)" Visibility="Collapsed" Click="Cancel_Click"/>
    <TextBlock x:Name="PromptLabel" FontFamily="Cascadia Mono, Consolas" Foreground="#AFA4FF" VerticalAlignment="Center" Margin="2,0,7,0" Text="PS&gt;"/>
    <TextBox x:Name="CommandBox" AcceptsReturn="False" FontFamily="Cascadia Mono, Consolas" FontSize="13" Background="Transparent" BorderThickness="0" Foreground="#F2F1F6" VerticalContentAlignment="Center" ToolTip="Enter a command and press Enter" PreviewKeyDown="CommandBox_PreviewKeyDown"/>
   </DockPanel>
  </Border>
  <DockPanel Grid.Row="3">
   <TextBlock x:Name="TerminalState" Foreground="#9C9AA8" Text="No active terminal session." TextWrapping="Wrap"/>
   <TextBlock x:Name="WorkingDirectoryLabel" DockPanel.Dock="Right" MaxWidth="520" Foreground="#777581" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
  </DockPanel>
  <TextBlock x:Name="DefaultDirectoryLabel" Visibility="Collapsed"/>
 </Grid>
</UserControl>
